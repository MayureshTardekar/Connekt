<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anonBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAnonPost"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/anonSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Drop a Note to the Void"
        app:titleTextColor="@color/anonPrimary"/>

    <!-- Content Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutAnonContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="What's heavily on your mind?"
        app:hintTextColor="@color/anonPrimary"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxStrokeColor="@color/anonPrimary"
        android:textColorHint="#9CA3AF"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarAnonPost">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAnonContent"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="top|start"
            android:textColor="#FFFFFF"
            android:inputType="textMultiLine"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="* Your identity is masked. Hate speech &amp; bullying will result in a shadow-ban via device footprint."
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAnonContent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitAnon"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Shout into the Void"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/anonBackground"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/anonPrimary"
        app:layout_constraintTop_toBottomOf="@id/tvWarning"/>

</androidx.constraintlayout.widget.ConstraintLayout>
