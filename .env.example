# Connekt — copy to .env (local only, never commit .env) or use the same
# variable names in CI / flutter run --dart-define=NAME=value
#
# This file is the single template for all compile-time and documented secrets.
# The Flutter app loads secrets via String.fromEnvironment (build-time).
# You must pass values with: flutter run --dart-define=KEY=value (repeat per key)
# or inject them in GitHub Actions / your CI.

# Supabase (required for live backend; omit to run in offline / mock path)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google AI (Gemini) — at least one if you use AI features
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_API_KEY_TERTIARY=

# Optional: fallback LLM (native; see app_config)
GROQ_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=

# Web OAuth: optional fixed redirect (otherwise current origin is used)
# WEB_REDIRECT_URL=

# Dev only: force mock backend
# USE_MOCK_BACKEND=true
